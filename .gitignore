# MigraLog.xcodeproj is generated from project.yml (xcodegen generate) but committed, so Dependabot can
# manage the Swift packages through its Package.resolved. After editing project.yml, regenerate and
# commit the result. Per-user state inside it stays out.
mobile-apps/ios/MigraLog.xcodeproj/xcuserdata/
mobile-apps/ios/MigraLog.xcodeproj/project.xcworkspace/xcuserdata/

